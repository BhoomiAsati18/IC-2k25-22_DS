
#include <iostream>
#include <vector>
#include <stack>
using namespace std;

int main() {
    int n;
    cin >> n;

    vector<int> a(n), ans(n, -1);
    for (int &x : a) cin >> x;

    stack<int> st; // indices

    for (int i = 2 * n - 1; i >= 0; --i) {
        int idx = i % n;

        while (!st.empty() && a[st.top()] <= a[idx])
            st.pop();

        if (i < n && !st.empty())
            ans[idx] = a[st.top()];

        st.push(idx);
    }

    for (int x : ans) cout << x << " ";
    cout << '\n';
    return 0;
}
